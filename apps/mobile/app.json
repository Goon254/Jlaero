{
  "expo": {
    "name": "Jlaero",
    "slug": "jlaero",
    "version": "0.1.0",
    "scheme": "jlaero",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b1220",
    "ios": {
      "bundleIdentifier": "com.jlaero.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.jlaero.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f4ee",
          "dark": {
            "backgroundColor": "#0b1220"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
